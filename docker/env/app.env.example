# Template for /home/mlr/marvinlerouge.dev/summit-stats/shared/env/app.env on the VPS (chmod 600).
# Non-secret settings, loaded into the app and queue containers through env_file in docker-compose.prod.yml.
# Secrets go to secrets.env (see secrets.env.example), loaded after this file so it wins.
# Local development keeps the single root .env (see .env.example).

APP_NAME="Summit Stats"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://summit-stats.marvinlerouge.dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
# warning, not error: failed logins are logged at warning level
LOG_LEVEL=warning
# One JSON object per line in docker logs (local dev keeps the readable text format)
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis has no password, it is only reachable on the internal network
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

ELEVATION_ENABLED=true
# OPENTOPODATA_URL=

SANCTUM_TOKEN_EXPIRATION=43200

SENTRY_ENVIRONMENT=production
