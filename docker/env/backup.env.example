# Template for /home/mlr/marvinlerouge.dev/summit-stats/shared/env/backup.env on the VPS (chmod 600).
# Read only by docker/scripts/backup.sh on the host, never by the containers.
# KEY=value lines, no quotes needed. Never commit the real file.

# Sender: a sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders)
BACKUP_MAIL_FROM=
BACKUP_MAIL_FROM_NAME=

# Recipient of the new-backup, still-alive and failure mails
BACKUP_MAIL_TO=
BACKUP_MAIL_TO_NAME=

# Brevo SMTP relay (SMTP & API > SMTP): login shown there, and an SMTP key (not the API key)
BACKUP_SMTP_HOST=smtp-relay.brevo.com
BACKUP_SMTP_PORT=587
BACKUP_SMTP_USER=
BACKUP_SMTP_PASSWORD=

# Prefix of the scp command in the new-backup mail: how your machine reaches the VPS
# (an ssh config alias works). Default: <current user>@<hostname -f>
BACKUP_SSH_TARGET=
