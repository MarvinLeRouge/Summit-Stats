# Template for /home/mlr/marvinlerouge.dev/summit-stats/shared/env/secrets.env on the VPS (chmod 600).
# Loaded into the app and queue containers (after app.env) and into the postgres container,
# through env_file in docker-compose.prod.yml. Each topic holding a secret is kept whole here.
# Never commit the real file. Local development keeps the single root .env (see .env.example).

# Laravel encryption key (generate with: php artisan key:generate --show)
APP_KEY=

# Database. POSTGRES_* initialise the postgres container (first start only) and are read by Laravel
# too (config/database.php falls back to them when DB_* are unset), so the password has a single copy.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=summit_stats
POSTGRES_USER=summit_stats
# generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Single app account, created by UserSeeder
APP_USER_NAME=
APP_USER_EMAIL=
APP_USER_PASSWORD=
APP_USER_PASSWORD_MIN_LENGTH=12
