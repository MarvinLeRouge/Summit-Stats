{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint resources/js --ext .js,.vue",
    "format": "prettier --write resources/js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "axios": "^1.21.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "laravel-vite-plugin": "^3.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "resources/js/**/*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.php": [
      "vendor/bin/pint"
    ]
  },
  "dependencies": {
    "@sentry/vue": "^11.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.1.0",
    "hammerjs": "^2.0.8",
    "leaflet": "^1.9.4",
    "leaflet.offline": "^3.2.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  }
}
